PROJECT_NAME=AI Signal
STACK_NAME=ai-signal
DOMAIN=localhost
ENVIRONMENT=local

# Docker image names used by compose.yml.
DOCKER_IMAGE_BACKEND=ai-signal-backend
DOCKER_IMAGE_FRONTEND=ai-signal-frontend
TAG=latest

# Auth/session secrets. Replace changethis before staging or production.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Frontend origin used by the backend for CORS and auth redirects.
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173

# Public origin of the FastAPI backend. Used to build absolute URLs in
# emails (currently: the digest unsubscribe link). Leave unset when the
# frontend and backend share an origin via a reverse proxy / platform
# rewrite. Set it when the API lives on its own host, or in local dev
# where Vite on :5173 doesn't proxy /api to :8000.
#   BACKEND_PUBLIC_URL=http://localhost:8000
#   BACKEND_PUBLIC_URL=https://api.aisignal.now
BACKEND_PUBLIC_URL=

# PostgreSQL / pgvector.
#
# Production (recommended for Neon and other managed providers): set
# DATABASE_URL to the full connection string, including any query params
# such as `?sslmode=require`. When DATABASE_URL is set it takes
# precedence over the split POSTGRES_* vars below, and a
# `postgresql://` scheme is auto-rewritten to `postgresql+psycopg://`
# for SQLAlchemy.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=
#
# Local development (Docker Compose): leave DATABASE_URL unset and use
# the split vars below.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Email — Resend (https://resend.com).
#
# All app email (password reset, account/system, daily digest) is
# delivered through Resend. Set RESEND_API_KEY plus a verified
# sender from your Resend domain (e.g. aisignal.now) to enable
# sending. When RESEND_API_KEY is empty the app logs a warning and
# silently skips sending — handy for local dev so you don't have
# to wire up an account.
RESEND_API_KEY=
# Default From: address. Must be a verified mailbox in your Resend
# domain. Used for password reset and other transactional mail.
EMAILS_FROM_EMAIL=hello@aisignal.now
# Display name shown in the From: header (e.g. "AI Signal
# <hello@aisignal.now>"). Defaults to PROJECT_NAME if unset.
EMAILS_FROM_NAME=AI Signal
# Sender for the daily digest. Optional — when unset the digest
# falls back to EMAILS_FROM_EMAIL. Splitting it (e.g.
# digest@aisignal.now) keeps bulk deliverability from contaminating
# the transactional reputation of EMAILS_FROM_EMAIL.
DIGEST_FROM_EMAIL=digest@aisignal.now
DIGEST_SEND_LOCAL_HOUR=6

# SMTP — legacy / deprecated.
#
# Pre-Resend, transactional mail went out over SMTP. The variables
# below are no longer read by the app (Resend is the only sender).
# Kept here so old environments don't fail Settings validation if
# they still have them set; remove them whenever you rotate env.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# SMTP_USER=
# SMTP_PASSWORD=

# Optional OAuth providers.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Ingestion scheduler. Leave unset locally unless testing scheduled ingest.
# Set explicitly (true/false) for staging and production so the deployed
# behavior does not silently change if the environment-aware default ever
# moves; the resolved default is enabled in non-local environments.
INGEST_SCHEDULER_ENABLED=
INGEST_INTERVAL_MINUTES=30
INGEST_INITIAL_DELAY_SECONDS=60

# Rate limiting. Multi-worker production must point this at a shared
# backend (e.g. redis://redis:6379) — the in-memory default lets each
# worker hand out the full per-bucket allowance, multiplying the limit
# by the worker count.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=

# Optional observability.
SENTRY_DSN=
