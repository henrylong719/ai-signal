<mjml>
  <mj-head>
    <mj-title>Reset your AI Signal password</mj-title>
    <mj-preview>Choose a new password for your AI Signal account.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#111111" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#FAFAF8">
    <mj-section padding="48px 20px">
      <mj-column>
        <mj-text align="center" padding="0 0 24px" font-size="18px" font-weight="700" letter-spacing="0.02em" color="#111111">AI Signal</mj-text>

        <mj-table padding="0">
          <tr>
            <td style="background:#FFFFFF;border:1px solid #E6E0D8;border-radius:16px;padding:40px 36px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;color:#111111;">
                    <h1 style="margin:0 0 18px;font-size:28px;line-height:1.2;font-weight:700;letter-spacing:-0.02em;">Reset your password</h1>
                    <p style="margin:0 0 18px;font-size:16px;line-height:1.6;color:#222222;">{{ greeting }}</p>
                    <p style="margin:0 0 18px;font-size:16px;line-height:1.6;color:#222222;">We received a request to reset your AI Signal password.</p>
                    <p style="margin:0 0 28px;font-size:16px;line-height:1.6;color:#222222;">Click the button below to choose a new password. This link will expire in {{ valid_hours }} hours.</p>

                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 28px;">
                      <tr>
                        <td bgcolor="#111111" style="border-radius:999px;">
                          <a href="{{ link }}" target="_blank" style="display:inline-block;padding:14px 24px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.2;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:999px;">Reset password</a>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:0 0 24px;font-size:16px;line-height:1.6;color:#222222;">If you didn't request this, you can safely ignore this email.</p>

                    <div style="border-top:1px solid #E6E0D8;padding-top:20px;">
                      <p style="margin:0 0 8px;font-size:12px;line-height:1.5;color:#6F6A61;">If the button doesn't work, copy and paste this link into your browser:</p>
                      <p style="margin:0;font-size:12px;line-height:1.5;word-break:break-all;"><a href="{{ link }}" target="_blank" style="color:#6F6A61;text-decoration:underline;">{{ link }}</a></p>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </mj-table>

        <mj-text align="center" padding="22px 24px 0" color="#6F6A61" font-size="13px" line-height="1.6">
          <strong style="color:#111111;font-size:14px;">AI Signal</strong><br />
          <span style="font-size:13px;">Find the signal in AI updates.</span><br />
          <span style="font-size:13px;">You received this email because a password reset was requested for your AI Signal account.</span>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
